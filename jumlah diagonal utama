public class JumlahDiagonalUtama {
    public static void main(String[] args) {
        int[][] angka = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };
        int total = 0;
        System.out.println("matriks:");
        for(int i = 0; i < 3; i++) {
            for(int j = 0; j < 3; j++) {
                System.out.print(angka[i][j] +" ");
            }
            System.out.println();
        }
        for(int i = 0; i < 3; i++) {
            total = total + angka[i][i];
        }
        System.out.println("\nJumlah diagonal utama:" + total);
    }
}
